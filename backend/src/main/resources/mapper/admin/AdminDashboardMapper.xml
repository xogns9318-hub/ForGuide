<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.forguide.admin.mapper.AdminDashboardMapper">

    <select id="findDashboard"
            resultType="com.example.forguide.admin.dto.AdminDashboardResponse">
        SELECT
        (
            SELECT COUNT(*)
            FROM members
        ) AS memberCount,
        (
            SELECT COUNT(*)
            FROM community_posts
        ) AS postCount,
        (
            SELECT COUNT(*)
            FROM community_comments
            WHERE is_deleted = 0
        ) AS commentCount
    </select>

</mapper>