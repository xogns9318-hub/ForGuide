# ForGuide 백엔드 (Spring Boot). 서버 재부팅 때 자동으로 켜진다.
# 설치: sudo cp forguide.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now forguide
[Unit]
Description=ForGuide backend
After=network-online.target mysql.service redis-server.service
# mysql은 Requires가 아니라 Wants: 자동 업데이트로 MySQL이 재시작될 때 백엔드까지 같이 멈추지 않게 한다.
Wants=network-online.target mysql.service

[Service]
User=forguide
Group=forguide
WorkingDirectory=/opt/forguide
EnvironmentFile=/etc/forguide/forguide.env
ExecStart=/usr/bin/java -Xms256m -Xmx768m -Duser.timezone=Asia/Seoul -jar /opt/forguide/forguide.jar
SuccessExitStatus=143
# 정상 종료(143)로 끝나도 다시 켠다. systemctl stop으로 직접 멈춘 경우는 다시 켜지 않는다.
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
