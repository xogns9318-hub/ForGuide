# ForGuide 서버 환경변수 (이 파일은 예시라 값이 비어 있다)
# 서버에서: sudo cp forguide.env.example /etc/forguide/forguide.env
#           sudo chmod 600 /etc/forguide/forguide.env  → 값을 채운다
# 채운 파일은 저장소·채팅·문서에 올리지 않는다.

# ── DB (같은 서버의 MySQL) ──
DB_URL=jdbc:mysql://127.0.0.1:3306/forguide?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=forguide
DB_PASSWORD=

# ── 로그인 (JWT) ──
# 만들기: openssl rand -base64 48
JWT_SECRET=
# HTTPS를 붙이기 전(HTTP)에는 false여야 refresh 쿠키가 브라우저에 저장된다
JWT_COOKIE_SECURE=false

# ── 관리자 계정 (서버 시작 때 없으면 만든다, 회원가입과 같은 아이디·비밀번호 규칙) ──
FORGUIDE_ADMIN_LOGIN_ID=
FORGUIDE_ADMIN_PASSWORD=
FORGUIDE_ADMIN_EMAIL=

# ── 메일 (회원가입·아이디 찾기·비밀번호 재설정 인증 코드) ──
FORGUIDE_MAIL_HOST=smtp.gmail.com
FORGUIDE_MAIL_PORT=587
FORGUIDE_MAIL_USERNAME=
FORGUIDE_MAIL_PASSWORD=
# 인증 코드를 서버 로그에 남길지 (개발용). 운영 서버에서는 false로 둔다
FORGUIDE_MAIL_ALLOW_DEV_LOG=false

# ── 외부 AI (없으면 해당 기능만 꺼진다) ──
FORGUIDE_OPENAI_API_KEY=
FORGUIDE_OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=

# ── 같은 서버의 Redis (번역 캐시) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── 사진 저장 위치 (서버 디스크의 고정 경로) ──
COMMUNITY_IMAGE_DIR=/var/lib/forguide/uploads/community-images
PROFILE_IMAGE_DIR=/var/lib/forguide/uploads/profile-images
INQUIRY_IMAGE_DIR=/var/lib/forguide/uploads/inquiry-images
# 아래 둘은 application.properties에 자리가 없어 Spring 설정 이름(forguide.resume-image.dir 등)으로 넘긴다
FORGUIDE_RESUMEIMAGE_DIR=/var/lib/forguide/uploads/resume-images
FORGUIDE_COMMUNITYREPORTIMAGE_DIR=/var/lib/forguide/uploads/community-report-images

# ── 기관 검색 (같은 서버의 Docker Elasticsearch, docs/deployment.md 5절) ──
# 검색 서버를 띄우기 전에는 false. 띄운 뒤 true로 바꾼다
FORGUIDE_ELASTICSEARCH_ENABLED=false
FORGUIDE_ELASTICSEARCH_URIS=http://127.0.0.1:9200
# 처음 한 번만 true로 켜서 MySQL 기관 자료를 검색 서버로 복사한다. 복사가 끝나면 false로 되돌린다
FORGUIDE_ELASTICSEARCH_REINDEX_ON_START=false
